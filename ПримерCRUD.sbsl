#требуется ВебСервер.sbsl

структура Пользователь
    обз знч Ид: Число
    обз знч Имя: Строка
    обз знч Возраст: Число
;

структура СоздатьПользователяDTO
    @JsonСвойство("name")
    обз знч Имя: Строка
    @JsonСвойство("age")
    обз знч Возраст: Число 
;

структура ПолучитьПользователяDTO
    @JsonСвойство("id")
    обз знч Ид: Число
    @JsonСвойство("name")
    обз знч Имя: Строка
    @JsonСвойство("age")
    обз знч Возраст: Число
;

структура РепозиторийПользователей
    обз знч Пользователи: Соответствие<Число, Пользователь>
    пер ТекущийИд: Число = 0
    
    статический метод НовыйРепозиторийПользователей(): РепозиторийПользователей
        возврат новый РепозиторийПользователей(новый Соответствие<Число, Пользователь>())
    ;
    
    метод Создать(Имя: Строка, Возраст: Число): Число
        знч ИдПользователя = ТекущийИд
        Пользователи.Вставить(ИдПользователя, новый Пользователь(ИдПользователя, Имя, Возраст))
        ТекущийИд += 1
        
        возврат ИдПользователя
    ;
    
    метод Найти(Ид: Число): Пользователь?
        возврат Пользователи.ПолучитьИлиНеопределено(Ид)
    ;
    
    метод НайтиВсех(): Массив<Пользователь>
        возврат Пользователи.Значения().ВМассив()
    ;
    
    метод Изменить(Ид: Число, Пользователь: Пользователь)
        Пользователи[Ид] = Пользователь
    ;
    
    метод Удалить(Ид: Число): Булево
        если Пользователи.Удалить(Ид) != Неопределено
            возврат Истина
        ;
        
        возврат Ложь
    ;
;

структура ОбработчикПользователей
    обз знч РепозиторийПользователей: РепозиторийПользователей
    
    метод Найти(Запрос: ВебСервер.Запрос): ВебСервер.Ответ
        знч ПараметрИд = Запрос.ПараметрыПути["id"]
        пер ИдПользователя = 0
        попытка 
            ИдПользователя = новый Число(ПараметрИд)
        поймать Исключение: ИсключениеНедопустимыйФормат
            Консоль.Записать("Параметр id должен быть числом!")
        ;
        
        знч Пользователь = РепозиторийПользователей.Найти(ИдПользователя)
        если Пользователь == Неопределено
            возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_404, "{\"message\": \"not found\"}")
        ;
        
        знч СтрокаJSON = Стд::Json::СериализацияJson.ЗаписатьОбъект(новый ПолучитьПользователяDTO(Пользователь.Ид, Пользователь.Имя, Пользователь.Возраст))
        
        возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_200, СтрокаJSON)
    ;

    метод НайтиВсех(Запрос: ВебСервер.Запрос): ВебСервер.Ответ
        знч Пользователи = РепозиторийПользователей.НайтиВсех()
        возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_200, Стд::Json::СериализацияJson.ЗаписатьОбъект(Пользователи))
    ;

    метод Создать(Запрос: ВебСервер.Запрос): ВебСервер.Ответ
        знч СозданныйПользователь = Стд::Json::СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<СоздатьПользователяDTO>)
        знч ИдПользователя = РепозиторийПользователей.Создать(СозданныйПользователь.Имя, СозданныйПользователь.Возраст)
        возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_201, "{\"id\":\"%ИдПользователя\"}")
    ;   
    
    метод Удалить(Запрос: ВебСервер.Запрос): ВебСервер.Ответ
        знч ПараметрИд = Запрос.ПараметрыПути["id"]
        пер ИдПользователя = 0
        попытка 
            ИдПользователя = новый Число(ПараметрИд)
        поймать Исключение: ИсключениеНедопустимыйФормат
            Консоль.Записать("Параметр id должен быть числом!")
        ;
        
        если РепозиторийПользователей.Удалить(ИдПользователя)
            возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_201, "{\"message\":\"user succesfully deleted\"}")
        ;
        
        возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_404, "{\"message\":\"not found\"}")
    ;
    
    статический метод НовыйОбработчикПользователей(РепозиторийПользователей: РепозиторийПользователей): ОбработчикПользователей
        возврат новый ОбработчикПользователей(РепозиторийПользователей)
    ;
;

метод Скрипт()
    знч РепозиторийПользователей = РепозиторийПользователей.НовыйРепозиторийПользователей()
    знч ОбработчикПользователей = ОбработчикПользователей.НовыйОбработчикПользователей(РепозиторийПользователей)
    
    знч Роутер = ВебСервер.Роутер.НовыйРоутер()
    знч Сервер = ВебСервер.Сервер.НовыйСервер("127.0.0.1", 8080, Роутер)
    
    Роутер.ЗарегистрироватьПуть("GET /users/{id}", метод(Запрос: ВебСервер.Запрос) -> возврат ОбработчикПользователей.Найти(Запрос);)
    Роутер.ЗарегистрироватьПуть("GET /users", метод(Запрос: ВебСервер.Запрос) -> возврат ОбработчикПользователей.НайтиВсех(Запрос);)
    Роутер.ЗарегистрироватьПуть("POST /users", метод(Запрос: ВебСервер.Запрос) -> возврат ОбработчикПользователей.Создать(Запрос);)
    Роутер.ЗарегистрироватьПуть("DELETE /users/{id}", метод(Запрос: ВебСервер.Запрос) -> возврат ОбработчикПользователей.Удалить(Запрос);)
    
    Сервер.Слушать()
;