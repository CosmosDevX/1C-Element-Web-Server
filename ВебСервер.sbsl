#совместимость 10.0

@Глобально
конст GET    = "GET"
@Глобально
конст POST   = "POST"
@Глобально
конст DELETE = "DELETE"
@Глобально
конст PUT    = "PUT"
@Глобально
конст PATCH  = "PATCH"

@Глобально
конст СТАТУС_200 = "200 OK"
@Глобально
конст СТАТУС_201 = "201 CREATED"
@Глобально
конст СТАТУС_404 = "404 NOT FOUND"

@Глобально
конст ЗАГОЛОВОК_CONTENT_LENGTH = "content-length"
@Глобально
конст ЗАГОЛОВОК_CONTENT_TYPE   = "content-type"
@Глобально
конст ТИП_КОНТЕНТА_JSON        = "application/json"

@Глобально
структура Запрос
    обз знч АдресКлиента: Строка
    обз знч ТипЗапроса: Строка
    обз знч ПутьЗапроса: Строка
    обз знч ВерсияHTTP: Строка
    обз знч Тело: Строка
    обз знч Заголовки: Соответствие<Строка, Строка>

    @Глобально
    метод ВывестиПредставление()
        Консоль.Записать(ТипЗапроса + " " + ПутьЗапроса)
        для Заголовок из Заголовки
            Консоль.Записать(Заголовок.Ключ + ": " + Заголовок.Значение)
        ;
        
        Консоль.Записать(Тело)
    ;

    @Локально
    статический метод СоздатьЗапрос(АдресКлиента: Строка, СтрокаЗапроса: Строка, СтрокаТела: Строка): Запрос
        знч МассивСтрок = СтрокаЗапроса.Разделить("\r\n")
        знч ЧастиСтартовойСтроки = МассивСтрок[0].Разделить(" ")
        знч Заголовки = новый Соответствие<Строка, Строка>()
        
        для Индекс = 1 по МассивСтрок.Граница()
            знч разделённаяСтрока = МассивСтрок[Индекс].Разделить('[:]', Ложь, 1)
            Заголовки.Вставить(разделённаяСтрока[0].Удалить(" "), разделённаяСтрока[1].Удалить(" "))
        ;
        
        знч ТипЗапроса = ЧастиСтартовойСтроки[0].Удалить(" ")
        знч ПутьЗапроса = ЧастиСтартовойСтроки[1].Удалить(" ")
        знч ВерсияHTTP = ЧастиСтартовойСтроки[2].Удалить(" ")
        
        возврат новый Запрос(
            АдресКлиента,
            ТипЗапроса,
            ПутьЗапроса,
            ВерсияHTTP,
            СтрокаТела,
            Заголовки
        )
    ;
    
    @Локально
    статический метод ПолучитьContentLength(СтрокаЗапроса: Строка): Число?
        знч МассивСтрок = СтрокаЗапроса.Разделить("\r\n")
        пер ContentLength: Число? = Неопределено
        для Индекс = 1 по МассивСтрок.Граница()
            знч разделённаяСтрока = МассивСтрок[Индекс].Разделить('[:]', Ложь, 1)
            если разделённаяСтрока[0].Сократить().ВНижнийРегистр() == ЗАГОЛОВОК_CONTENT_LENGTH
                ContentLength = новый Число(разделённаяСтрока[1].Сократить())
            ;
        ;
        
        возврат ContentLength
    ;
;

@Глобально
структура Ответ
    обз знч ВерсияHTTP: Строка
    обз знч Статус: Строка
    обз знч Заголовки: Соответствие<Строка, Строка|Число>
    обз знч Тело: Строка
    
    @Локально
    метод ЗаписатьВСтроку(): Строка
        пер СтрокаОтвета = ""
        СтрокаОтвета = СтрокаОтвета + ВерсияHTTP + " " + Статус + "\r\n"
        для Заголовок из Заголовки
            СтрокаОтвета = СтрокаОтвета + Заголовок.Ключ + ": " + Заголовок.Значение +"\r\n"
        ;
        СтрокаОтвета = СтрокаОтвета + "\r\n" + Тело
        
        возврат СтрокаОтвета
    ;
    
    @Глобально
    статический метод СоздатьОтвет(ВерсияHTTP: Строка, КодОтвета: Строка, ТелоОтвета: Строка, ТипКонтента: Строка = "application/json"): Ответ
        знч Заголовки = новый Соответствие<Строка, Строка|Число>()
        Заголовки.Вставить(ЗАГОЛОВОК_CONTENT_TYPE, ТипКонтента)
        знч КоличествоБайтов = ТелоОтвета.ВБайты(Кодировка.Utf8).Длина()
        Консоль.Записать("%ТелоОтвета: кол-во байтов - %КоличествоБайтов")
        Заголовки.Вставить(ЗАГОЛОВОК_CONTENT_LENGTH, КоличествоБайтов)
        
        возврат новый Ответ(ВерсияHTTP, КодОтвета, Заголовки, ТелоОтвета)
    ;
;

@Глобально
структура Путь
    обз знч HTTPМетод: Строка
    обз знч СтрокаПути: Строка
;

@Глобально
структура Сервер
    обз знч Адрес: Строка
    обз знч Порт: Число
    
    @Глобально
    метод ЗапуститьСервер(): БлокирующийСерверTcp
        Консоль.Записать("Запущен Блокирующий Tcp Сервер по адресу: localhost:%Порт")
        возврат новый БлокирующийСерверTcp(Адрес = Адрес, Порт = Порт)
    ;
    
    @Глобально
    статический метод НовыйСервер(Адрес: Строка, Порт: Число): Сервер
        возврат новый Сервер(Адрес, Порт)
    ;
;

@Глобально
структура МенеджерСоединений
    обз знч Роутер: Роутер
    
    @Глобально
    метод СлушатьСоединения(Сервер: БлокирующийСерверTcp)
        пока Истина
            исп Соединение = Сервер.ОжидатьСоединения(20с)
            знч ЧтениеДанных = новый ЧтениеДанных(Соединение.ПолучитьПотокЧтения())
            знч СтрокаЗапроса = ЧтениеДанных.ПрочитатьДо("\r\n\r\n").ОткрытьПотокЧтения().ПрочитатьКакСтроку(Кодировка.Utf8)
            знч ContentLength = Запрос.ПолучитьContentLength(СтрокаЗапроса)
            пер СтрокаТела = ""
            если ContentLength != Неопределено и ContentLength != 0
                СтрокаТела = ЧтениеДанных.Прочитать(ContentLength).ОткрытьПотокЧтения().ПрочитатьКакСтроку(Кодировка.Utf8)
            ;
            знч Запрос = Запрос.СоздатьЗапрос(Соединение.ВСтроку(), СтрокаЗапроса, СтрокаТела)
            Запрос.ВывестиПредставление()
    
            исп ПотокЗаписи = Соединение.ПолучитьПотокЗаписи()
            ПотокЗаписи.Записать(Роутер.Сопоставить(Запрос).ЗаписатьВСтроку())
            ПотокЗаписи.СброситьБуферы()
        ;
    ;
    
    @Глобально
    статический метод НовыйМенеджерСоединений(Роутер: Роутер): МенеджерСоединений
        возврат новый МенеджерСоединений(Роутер)
    ;
;

@Глобально
структура Роутер
    обз знч КартаПутей: Соответствие<Путь, (Запрос) -> Ответ>
    
    @Глобально
    метод ЗарегистрироватьПуть(Путь: Строка, Обработчик: (Запрос) -> Ответ)
        знч Части = Путь.Сократить().Разделить(" ")
        знч HTTPМетод = Части[0]
        знч СтрокаПути = Части[1]
        
        КартаПутей.Вставить(новый Путь(HTTPМетод, СтрокаПути), Обработчик)
    ;
    
    @Локально
    метод Сопоставить(Запрос: Запрос): Ответ
        знч РазбитыйИскомыйПуть = Запрос.ПутьЗапроса.Разделить("/")
        
        //TODO: O(m * n) сложность алгоритма
        для Пара из КартаПутей
            знч РазбитыйТекущийПуть = Пара.Ключ.СтрокаПути.Разделить("/")
            если РазбитыйИскомыйПуть.Граница() != РазбитыйТекущийПуть.Граница()
                прервать
            ;
            для Индекс = 0 по РазбитыйИскомыйПуть.Граница() + 1
                если РазбитыйИскомыйПуть[Индекс] != РазбитыйТекущийПуть[Индекс]
                    прервать
                ;
                
                если Индекс == РазбитыйИскомыйПуть.Граница()
                    если Запрос.ТипЗапроса != Пара.Ключ.HTTPМетод
                        прервать
                    ;
                    
                    знч обработчик = Пара.Значение
                    возврат обработчик(Запрос)
                ;
            ;
        ;
        
        возврат Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, СТАТУС_404, "{\"error\": \"not found\"}")
    ;
    
    @Глобально
    статический метод НовыйРоутер(): Роутер
        возврат новый Роутер(новый Соответствие<Путь, (Запрос) -> Ответ>())
    ;
;