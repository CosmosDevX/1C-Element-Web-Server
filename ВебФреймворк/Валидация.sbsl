#совместимость 10.0

@Глобально
конст ПАРАМЕТР_МИНИМУМ = "минимум"

@Глобально
конст ПАРАМЕТР_МАКСИМУМ = "максимум"

@Глобально
исключение ОшибкаВалидации
;

@Глобально
структура ПравилоВалидации
    обз знч СтрокаПараметров: Строка
;

@Глобально
структура Валидатор
    обз знч ПараметрыВалидации: Соответствие<Строка, (Строка, Объект?, Число)->ничто>

    @Локально
    метод ПроверитьПравилоВалидации(ИмяПравила: Строка, ЗначениеПравила: Число, ИмяСвойства: Строка,
            ЗначениеСвойства: Объект?)

        знч МетодВалидации = ПараметрыВалидации[ИмяПравила]
        МетодВалидации(ИмяСвойства, ЗначениеСвойства, ЗначениеПравила)
    ;

    /// Производит валидацию свойств экземпляра структуры
    ///
    /// @параметр Экземпляр - экземпляр валидируемой структуры
    /// @параметр ПравилаВалидации - соответствие, где ключ - ИмяСвойстваСтруктуры(Строка) и ПравилоВалидации - экзмепляр структуры ПравилоВалидации
    ///
    /// @выбрасывает ОшибкаВалидации - если в процессе валидации произошло нарушение инварианта.
    /// @см Образец строки правил в ПравилоВалидации - "Правило = Значение; Правило = Значение" (Например: "минимум = 10; максимум = 15")
    @Глобально
    метод Валидировать(Экземпляр: Объект, ПравилаВалидации: Соответствие<Строка, ПравилоВалидации>)
        знч СвойстваЭкземпляра = Экземпляр.ПолучитьТип().ПолучитьСвойства()
        для Свойство из СвойстваЭкземпляра
            знч КартаПараметровВалидации = новый Соответствие<Строка, Число>()
            знч ПравилоВалидации = ПравилаВалидации.ПолучитьИлиНеопределено(Свойство.ВСтроку())
            если ПравилоВалидации == Неопределено
                продолжить
            ;

            знч ЧастиПравил = ПравилоВалидации.СтрокаПараметров.Удалить(" ").Разделить(";")

            для Часть из ЧастиПравил
                знч ПараНазваниеЗначениеПравила = Часть.Разделить("=")
                КартаПараметровВалидации.Вставить(ПараНазваниеЗначениеПравила[0], новый Число(
                        ПараНазваниеЗначениеПравила[1]))
            ;

            для ПараметрВалидации из КартаПараметровВалидации
                ПроверитьПравилоВалидации(ПараметрВалидации.Ключ, ПараметрВалидации.Значение, Свойство.ВСтроку(),
                    Свойство.Получить(
                        Экземпляр))
            ;
        ;
    ;

    @Локально
    статический метод ПроверитьЗначениеПоПредикату(ИмяСвойства: Строка, ЗначениеСвойства: Объект?, НазваниеИнварианта: Строка, Инвариант: Число, Оператор: Строка, Предикат: (Число)->Булево)
        если ЗначениеСвойства это Строка
            знч Длина = (ЗначениеСвойства как Строка).Длина()
            если Предикат(Длина)
                выбросить новый ОшибкаВалидации(
                                        "Нарушен инвариант параметра %НазваниеИнварианта %Длина %Оператор %Инвариант. Свойство - %ИмяСвойства")
            ;
            возврат
        ;

        если ЗначениеСвойства это Число
            знч Число = новый Число(ЗначениеСвойства.ВСтроку())
            если Предикат(Число)
                выбросить новый ОшибкаВалидации(
                                        "Нарушен инвариант параметра %НазваниеИнварианта %Число %Оператор %Инвариант. Свойство - %ИмяСвойства")
            ;
            возврат
        ;
    ;

    /// Создаёт экземпляр структуры Валидатор
    /// @возвращает Экземпляр структуры Валидатор
    @Глобально
    статический метод НовыйВалидатор(): Валидатор
        знч ПараметрыВалидации = новый Соответствие<Строка, (Строка, Объект?, Число)->ничто>()
        ПараметрыВалидации.Вставить(ПАРАМЕТР_МИНИМУМ, метод(ИмяСвойства: Строка, ЗначениеСвойства: Объект?, Минимум: Число) ->
                ПроверитьЗначениеПоПредикату(ИмяСвойства, ЗначениеСвойства, ПАРАМЕТР_МИНИМУМ, Минимум, "<", (Число) -> Число < Минимум)
            ;)
        ПараметрыВалидации.Вставить(ПАРАМЕТР_МАКСИМУМ, метод(ИмяСвойства: Строка, ЗначениеСвойства: Объект?, Максимум: Число) ->
                ПроверитьЗначениеПоПредикату(ИмяСвойства, ЗначениеСвойства, ПАРАМЕТР_МАКСИМУМ, Максимум, ">", (Число) -> Число > Максимум)
            ;)

        возврат новый Валидатор(ПараметрыВалидации)
    ;
;

структура Пользователь
    обз знч Имя: Строка
    обз знч Возраст: Число
;

метод Скрипт()
    знч Пользователь = новый Пользователь("Пользователь", 16)
    знч Валидатор = Валидатор.НовыйВалидатор()
    знч Правила = новый Соответствие<Строка, ПравилоВалидации>()
    Правила.Вставить("Имя", новый ПравилоВалидации("минимум = 1; максимум = 50"))
    Правила.Вставить("Возраст", новый ПравилоВалидации("минимум = 1"))

    Валидатор.Валидировать(Пользователь, Правила)
;