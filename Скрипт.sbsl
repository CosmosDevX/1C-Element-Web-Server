конст GET = "GET"
конст POST = "POST"
конст DELETE = "DELETE"
конст PUT = "PUT"

конст STATUS_200 = "200 OK"
конст STATUS_404 = "404 NOT FOUND"

конст ТИП_КОНТЕНТА_JSON = "application/json"

структура Запрос
    обз знч АдресКлиента: Строка
    обз знч ТипЗапроса: Строка
    обз знч ПутьЗапроса: Строка
    обз знч ВерсияHTTP: Строка
    обз знч ТелоЗапроса: Строка
    обз знч Заголовки: Соответствие<Строка, Строка>

    метод ВывестиПредставление()
        Консоль.Записать(ТипЗапроса + " " + ПутьЗапроса)
        для Заголовок из Заголовки
            Консоль.Записать(Заголовок.Ключ + ": " + Заголовок.Значение)
        ;
    ;

    статический метод ИзСтроки(АдресКлиента: Строка, СтрокаЗапроса: Строка): Запрос
        знч массивСтрок = СтрокаЗапроса.Разделить("\r\n")
        знч частиСтартовойСтроки = массивСтрок[0].Разделить(" ")
        знч Заголовки = новый Соответствие<Строка, Строка>()
        
        для Индекс = 1 по массивСтрок.Граница()
            знч разделённаяСтрока = массивСтрок[Индекс].Разделить(": ")
            Заголовки.Вставить(разделённаяСтрока[0], разделённаяСтрока[1])
        ;
        
        возврат новый Запрос(
            АдресКлиента,
            частиСтартовойСтроки[0].Удалить(" "),
            частиСтартовойСтроки[1].Удалить(" "),
            частиСтартовойСтроки[2].Удалить(" "),
            "ТелоЗапроса",
            Заголовки
        )
    ;
;
структура Ответ
    обз знч ВерсияHTTP: Строка
    обз знч Статус: Строка
    обз знч Заголовки: Соответствие<Строка, Строка>
    обз знч ТелоОтвета: Строка
    
    метод ЗаписатьВСтроку(): Строка
        пер СтрокаОтвета = ""
        СтрокаОтвета = СтрокаОтвета + ВерсияHTTP + " " + Статус + "\r\n"
        для Заголовок из Заголовки
            СтрокаОтвета = СтрокаОтвета + Заголовок.Ключ + ": " + Заголовок.Значение +"\r\n"
        ;
        СтрокаОтвета = СтрокаОтвета + "\r\n" + ТелоОтвета
        
        возврат СтрокаОтвета
    ;
    
    статический метод СоздатьОтвет(ВерсияHTTP: Строка, КодОтвета: Строка, ТелоОтвета: Строка, ТипКонтента: Строка): Ответ
        знч Заголовки = новый Соответствие<Строка, Строка>()
        Заголовки.Вставить("Content-Type", ТипКонтента)
        возврат новый Ответ(ВерсияHTTP, КодОтвета, Заголовки, ТелоОтвета)
    ;
;

структура Сервер
    обз знч Адрес: Строка
    обз знч Порт: Число

    @ИменованныеПараметры
    конструктор
    
    метод ЗапуститьСервер(): БлокирующийСерверTcp
        возврат новый БлокирующийСерверTcp(Адрес = Адрес, Порт = Порт)
    ;
;

структура МенеджерСоединений
    обз знч Роутер: Роутер
    
    метод СлушатьСоединения(Сервер: БлокирующийСерверTcp)
        пока Истина
            знч Соединение = Сервер.ОжидатьСоединения(900с)
            знч ЧтениеДанных = новый ЧтениеДанных(Соединение.ПолучитьПотокЧтения())
            знч СтрокаЗапроса = ЧтениеДанных.ПрочитатьДо("\r\n\r\n").ОткрытьПотокЧтения().ПрочитатьКакСтроку(Кодировка.Ascii)
            знч Запрос = Запрос.ИзСтроки(Соединение.ВСтроку(), СтрокаЗапроса)
     
            знч потокЗаписи = Соединение.ПолучитьПотокЗаписи()
            потокЗаписи.Записать(Роутер.Сопоставить(Запрос).ЗаписатьВСтроку())
            потокЗаписи.СброситьБуферы()
            Соединение.Закрыть()
        ;
    ;
;

структура Роутер
    обз знч КартаПутей: Соответствие<Строка, (Запрос) -> Ответ>
    
    метод ЗарегистрироватьПуть(СтрокаПути: Строка, Обработчик: (Запрос) -> Ответ)
        КартаПутей.Вставить(СтрокаПути, Обработчик)
    ;
    
    //TODO: сделать написать алгоритм сопоставления и добавить поддержку path parametrs
    метод Сопоставить(Запрос: Запрос): Ответ
        знч ключ = Запрос.ТипЗапроса + " " + Запрос.ПутьЗапроса
        если КартаПутей.СодержитКлюч(ключ)
            знч обработчик = КартаПутей[ключ]
            возврат обработчик(Запрос)   
        ;
        
        возврат новый Ответ(Запрос.ВерсияHTTP, STATUS_404, новый Соответствие<Строка, Строка>(), Запрос.ТелоЗапроса)
    ;
;

метод ОбработатьПолучитьПользователей(Запрос: Запрос): Ответ
    знч Пользователи = "{{\"name\":\"Андрей\"}, {\"name\":\"Александр\"}, {\"name\":\"Егор\"}}"
    возврат Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, STATUS_200, Пользователи, ТИП_КОНТЕНТА_JSON)
;


метод Скрипт()
    знч сервер = новый Сервер(Адрес = "127.0.0.1", Порт = 8080)
    знч роутер = новый Роутер(новый Соответствие<Строка, (Запрос) -> Ответ>())
    знч менеджерСоединений = новый МенеджерСоединений(роутер)
    роутер.ЗарегистрироватьПуть("GET /api/v1/users", метод(Запрос: Запрос) -> возврат ОбработатьПолучитьПользователей(Запрос);)
    
    знч серверTCP = сервер.ЗапуститьСервер()
    менеджерСоединений.СлушатьСоединения(серверTCP)
;