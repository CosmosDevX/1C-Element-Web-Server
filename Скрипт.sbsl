#требуется ВебСервер.sbsl

метод ОбработатьПолучитьПользователей(Запрос: ВебСервер.Запрос): ВебСервер.Ответ
    знч Пользователи = "[{\"name\":\"Андрей\"}, {\"name\":\"Александр\"}, {\"name\":\"Егор\"}]"
    возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_200, Пользователи)
;

метод ОбработатьСоздатьПользователя(Запрос: ВебСервер.Запрос): ВебСервер.Ответ
    знч ИдПользователя = "{\"id\": 1}"
    возврат ВебСервер.Ответ.СоздатьОтвет(Запрос.ВерсияHTTP, ВебСервер.СТАТУС_201, ИдПользователя)
;

метод Скрипт()
    знч Сервер = ВебСервер.Сервер.НовыйСервер("127.0.0.1", 8080)
    знч Роутер = ВебСервер.Роутер.НовыйРоутер()
    знч МенеджерСоединений = ВебСервер.МенеджерСоединений.НовыйМенеджерСоединений(Роутер)
    Роутер.ЗарегистрироватьПуть("GET /api/v1/users", метод(Запрос: ВебСервер.Запрос) -> возврат ОбработатьПолучитьПользователей(Запрос);)
    Роутер.ЗарегистрироватьПуть("POST /api/v1/users", метод(Запрос: ВебСервер.Запрос) -> возврат ОбработатьСоздатьПользователя(Запрос);)
    
    знч серверTCP = Сервер.ЗапуститьСервер()
    МенеджерСоединений.СлушатьСоединения(серверTCP)
;